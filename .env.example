# ==============================================================================
# QIVORA — Smart Library Management System
# Environment Configuration Template (.env.example)
# Designed & Developed by MOHAMMAD SHARIQ · BCA 1st Year | 2026–2027 Batch
# ==============================================================================
# NEVER commit real secrets or service-role keys to source control.
# Configure real values in AI Studio Secrets or your hosting provider's dashboard.

APP_URL="http://localhost:3000"

# ==============================================================================
# 1. OFFICIAL SUPABASE CONFIGURATION (@supabase/supabase-js)
# ==============================================================================
# Frontend-safe variables (exposed to browser via Vite):
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Provide EITHER VITE_SUPABASE_ANON_KEY OR VITE_SUPABASE_PUBLISHABLE_KEY:
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Server-only secret (NEVER prefix with VITE_ and NEVER expose in frontend code):
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY"

# ==============================================================================
# 2. PRIMARY POSTGRESQL / CLOUD SQL CONNECTION (Auto-injected in AI Studio)
# ==============================================================================
# SQL_HOST=""
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_DB_NAME=""
# SQL_ADMIN_USER="mohammdshariq@gmail.com"
# SQL_ADMIN_PASSWORD="Shariq@2109"

# ==============================================================================
# 3. AUTHENTICATION & SESSION SECURITY
# ==============================================================================
# Strong 32+ byte random secret for signing institutional session tokens:
SESSION_SECRET="replace-with-strong-32-byte-random-secret"

# Platform Super Admin primary login email & optional headless initial password
# (Never hardcode real passwords in frontend or git; if left blank, the secure
# one-time server-side setup UI prompts to initialize the password on first run.)
SUPER_ADMIN_EMAIL="mohammad@shariq.com"
SUPER_ADMIN_INITIAL_PASSWORD=""
# Optional comma-separated additional OAuth Super Admin emails:
# SUPER_ADMIN_EMAILS="mohammad@shariq.com"


# ==============================================================================
# 4. OPTIONAL EXTERNAL INTEGRATIONS (Disabled unless real credentials are set)
# ==============================================================================
# SMTP Email Delivery
# SMTP_HOST="smtp.yourprovider.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="QIVORA Library <noreply@yourdomain.edu>"

# Web Push Notifications (VAPID)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# WhatsApp Cloud API
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

