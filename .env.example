# ==============================================================================
# QIVORA — Smart Library Management System
# Environment Configuration Template (.env.example)
# Firebase-Only Architecture (Firebase Authentication + Cloud Firestore)
# ==============================================================================
# Note: Public Firebase web configuration defaults are already loaded from
# /firebase-applet-config.json. You can override any value in Vercel or local
# environments using the VITE_FIREBASE_* variables below.

APP_URL="https://qivora-pi.vercel.app"

# Firebase Web App Configuration (safe for client bundle — security enforced by firestore.rules)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="poetic-transport-sbvhw.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="poetic-transport-sbvhw"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="poetic-transport-sbvhw.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-smartlibrary-d1beb0f3-d031-4ab4-8b16-f28ff91b471e"
